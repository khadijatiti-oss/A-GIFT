// App.tsx
import React, { useState, useEffect } from "react";
import { AppState, UserData } from "./types";
import Avatar from "./components/Avatar";
import ForestScene from "./components/ForestScene";
import PartyScene from "./components/PartyScene";
import { speak } from "./services/geminiService";

const App: React.FC = () => {
  const [currentStep, setCurrentStep] = useState<AppState>(AppState.WHO_AM_I);
  const [userData, setUserData] = useState<UserData>({
    senderName: "",
    recipientName: "",
  });
  const [typedName, setTypedName] = useState("");
  const [error, setError] = useState<string | null>(null);

  // Voice lines
  useEffect(() => {
    if (currentStep === AppState.FOREST_WALK) {
      const playForestDialog = async () => {
        await speak("*footsteps on leaves* *gentle wind* Haven't seen you in a while! *soft chuckle*");
        await new Promise(r => setTimeout(r, 2000));
        await speak("I've prepared something very special just for you, because you are amazing!");
        await new Promise(r => setTimeout(r, 2000));
        await speak("You've grown so much! I'm so proud of you.");
        await new Promise(r => setTimeout(r, 2000));
        await speak("Keep holding my hand... we're almost there. You'll be so shocked!");
      };
      playForestDialog();
    } else if (currentStep === AppState.SURPRISE_PARTY) {
      const playSurprise = async () => {
        await speak(`*excited shouting* Welcome to your party, ${userData.recipientName}!! Happy Birthday!! 🎉`);
      };
      playSurprise();
    }
  }, [currentStep, userData.recipientName]);

  const handleIdentityCheck = (e: React.FormEvent) => {
    e.preventDefault();
    if (typedName.trim().length < 2) {
      setError("Please tell me your name first! ❤️");
      return;
    }
    setUserData(prev => ({ ...prev, senderName: typedName }));
    setError(null);
    setCurrentStep(AppState.THROW_FLOWERS);
  };

  const handleRecipientConfirm = (e: React.FormEvent) => {
    e.preventDefault();
    if (userData.recipientName.trim().length < 2) {
      setError("Who is the birthday star? ✨");
      return;
    }
    setCurrentStep(AppState.FOREST_WALK);
  };

  // Screens
  const renderWhoAmI = () => (
    <div className="min-h-screen flex flex-col items-center justify-center p-6 bg-purple-50 text-center">
      <div className="max-w-md w-full bg-white rounded-[2rem] shadow-2xl p-10 space-y-8">
        <h1 className="text-4xl font-bold text-purple-600">Wait! ✋</h1>
        <p className="text-gray-600 text-lg">Before we begin the magic...</p>
        <form onSubmit={handleIdentityCheck} className="space-y-6">
          <input
            type="text"
            autoFocus
            className="w-full px-6 py-4 rounded-2xl border-2 border-purple-100 focus:border-purple-500 outline-none text-center text-xl font-medium"
            placeholder="Type my name..."
            value={typedName}
            onChange={(e) => setTypedName(e.target.value)}
          />
          {error && <p className="text-rose-500 font-medium animate-bounce">{error}</p>}
          <button
            type="submit"
            className="w-full py-5 bg-gradient-to-r from-purple-500 to-indigo-600 text-white rounded-2xl font-bold text-xl shadow-xl transform active:scale-95 transition-all"
          >
            Reveal Me ✨
          </button>
        </form>
      </div>
    </div>
  );

  const renderThrowFlowers = () => (
    <div className="min-h-screen bg-white flex flex-col items-center justify-center relative overflow-hidden p-6">
      <div className="absolute inset-0 pointer-events-none">
        {Array.from({ length: 40 }).map((_, i) => (
          <div
            key={i}
            className="absolute animate-bounce text-3xl"
            style={{
              left: `${Math.random() * 100}%`,
              top: `${-20 + Math.random() * 100}%`,
              animationDelay: `${Math.random() * 2}s`,
              animationDuration: `${3 + Math.random() * 2}s`,
              opacity: 0.7,
            }}
          >
            {["🌸", "🌺", "🌹", "🌻", "🌷", "🌼"][
              Math.floor(Math.random() * 6)
            ]}
          </div>
        ))}
      </div>
      <div className="z-10 text-center space-y-8 max-w-lg">
        <h2 className="text-5xl font-bold text-purple-600 animate-pulse">
          It's me, {userData.senderName}!
        </h2>
        <Avatar variant="child" className="w-72 h-72 floating" />
        <p className="text-2xl text-purple-400 font-medium italic">
          Surprise! I'm so excited! 🌸
        </p>
        <form onSubmit={handleRecipientConfirm} className="space-y-4">
          <input
            type="text"
            className="w-full px-6 py-4 rounded-2xl border-2 border-purple-100 focus:border-purple-500 outline-none text-center text-lg"
            placeholder="What is your name? (The Birthday Star)"
            value={userData.recipientName}
            onChange={(e) =>
              setUserData({ ...userData, recipientName: e.target.value })
            }
          />
          <button
            type="submit"
            className="px-16 py-5 bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded-full font-bold text-2xl shadow-2xl hover:scale-110 active:scale-95 transition-all"
          >
            Let's Go! 🚀
          </button>
        </form>
      </div>
    </div>
  );

  const renderForestWalk = () => (
    <ForestScene
      recipientName={userData.recipientName}
      senderName={userData.senderName}
      onComplete={() => setCurrentStep(AppState.SURPRISE_PARTY)}
    />
  );

  const renderSurpriseParty = () => (
    <PartyScene
      recipientName={userData.recipientName}
      senderName={userData.senderName}
      onClickAvatar={() => setCurrentStep(AppState.FINAL_PRESENT)}
    />
  );

  const renderFinalPresent = () => (
    <div className="min-h-screen bg-gradient-to-br from-purple-50 via-white to-pink-50 flex flex-col items-center justify-center p-6 text-center">
      <div className="max-w-xl w-full bg-white rounded-[4rem] shadow-2xl p-16 space-y-10 relative overflow-hidden border border-purple-50">
        {Array.from({ length: 25 }).map((_, i) => (
          <div
            key={i}
            className="absolute text-4xl animate-pulse"
            style={{
              left: `${Math.random() * 100}%`,
              top: `${Math.random() * 100}%`,
            }}
          >
            🌸
          </div>
        ))}
        <h1 className="text-5xl font-bold text-purple-600">
          HAPPY BIRTHDAY!
        </h1>
        <div className="flex flex-col items-center space-y-6">
          <div className="text-9xl animate-bounce filter drop-shadow-2xl">💐</div>
          <p className="text-3xl font-bold">
            Here is your bouquet, {userData.recipientName}!
          </p>
        </div>
        <button
          onClick={() => window.location.reload()}
          className="px-10 py-4 bg-purple-100 text-purple-600 rounded-2xl font-bold text-lg hover:bg-purple-200 transition-all active:scale-95"
        >
          Journey Again 💖
        </button>
      </div>
      <p className="mt-10 text-purple-400 font-bold text-xl tracking-widest">
        With endless love, {userData.senderName}
      </p>
    </div>
  );

  switch (currentStep) {
    case AppState.WHO_AM_I:
      return renderWhoAmI();
    case AppState.THROW_FLOWERS:
      return renderThrowFlowers();
    case AppState.FOREST_WALK:
      return renderForestWalk();
    case AppState.SURPRISE_PARTY:
      return renderSurpriseParty();
    case AppState.FINAL_PRESENT:
      return renderFinalPresent();
    default:
      return renderWhoAmI();
  }
};

export default App;
// ForestScene.tsx
import React, { useEffect } from "react";
import Avatar from "./Avatar";

interface Props {
  recipientName: string;
  senderName: string;
  onComplete: () => void;
}

const ForestScene: React.FC<Props> = ({ recipientName, senderName, onComplete }) => {
  useEffect(() => {
    const timer = setTimeout(() => {
      onComplete();
    }, 10000); // 10s walk
    return () => clearTimeout(timer);
  }, [onComplete]);

  return (
    <div className="relative w-full h-screen bg-[url('/assets/forest-bg.jpg')] bg-cover bg-center overflow-hidden">
      {/* Ambient sounds */}
      <audio src="/assets/forest-sounds.mp3" autoPlay loop />
      {/* Path overlay */}
      <div className="absolute bottom-0 w-full h-32 bg-gradient-to-t from-black/40 to-transparent" />
      {/* Avatar walking */}
      <Avatar
        variant="child"
        className="absolute bottom-20 left-10 animate-walk"
      />
      {/* Hand-holding overlay */}
      <div className="absolute bottom-0 left-0 w-full h-1/3 pointer-events-none flex justify-center items-end">
        <p className="bg-black/40 text-white px-4 py-2 rounded-full text-lg font-semibold animate-pulse">
          Hold my hand... 🤝
        </p>
      </div>
    </div>
  );
};

export default ForestScene;
